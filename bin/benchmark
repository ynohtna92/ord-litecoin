#!/usr/bin/env bash

set -euxo pipefail

rm -rf tmp/benchmark
mkdir -p tmp/benchmark

INDEX_SNAPSHOT=$1
HEIGHT_LIMIT=$2

cp $INDEX_SNAPSHOT tmp/benchmark/index.redb

if command -v python > /dev/null; then
  python bin/prepare-vendor
else
  python3 bin/prepare-vendor
fi

cargo build --release

time ./target/release/ord --datadir tmp/benchmark --height-limit $HEIGHT_LIMIT index update
