#!/usr/bin/env bash

set -euxo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

if command -v python > /dev/null; then
  python "$ROOT/bin/prepare-vendor"
else
  python3 "$ROOT/bin/prepare-vendor"
fi

mkdir -p -- "$1"
cd -- "$1"

sudo \
  CARGO_PROFILE_RELEASE_DEBUG=true \
  RUST_LOG=info \
  cargo flamegraph \
  --manifest-path "$ROOT/Cargo.toml" \
  --deterministic \
  --bin ord \
  -- \
  --chain "${CHAIN:-mainnet}" \
  --datadir . \
  --height-limit 0 \
  index update

rm -f flamegraph.svg

/usr/bin/time -o time sudo \
  CARGO_PROFILE_RELEASE_DEBUG=true \
  RUST_LOG=info \
  cargo flamegraph \
  --manifest-path "$ROOT/Cargo.toml" \
  --deterministic \
  --bin ord \
  -- \
  --chain "${CHAIN:-mainnet}" \
  --datadir . \
  --height-limit 5000 \
  index update

sudo chown "$UID" flamegraph.svg
sudo chown "$UID" index.redb
