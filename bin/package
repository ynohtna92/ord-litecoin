#!/usr/bin/env bash

set -euxo pipefail

VERSION=${REF#"refs/tags/"}
DIST=`pwd`/dist

echo "Packaging ord $VERSION for $TARGET..."

if command -v python > /dev/null; then
  python bin/prepare-vendor
else
  python3 bin/prepare-vendor
fi

test -f Cargo.lock || cargo generate-lockfile

echo "Building ord..."
RUSTFLAGS="--deny warnings $TARGET_RUSTFLAGS" \
  cargo build --bin ord --locked --target "$TARGET" --release
EXECUTABLE=target/$TARGET/release/ord

if [[ $OS == windows-* ]]; then
  EXECUTABLE=$EXECUTABLE.exe
fi

echo "Copying release files..."
mkdir -p dist/ord-$VERSION
cp \
  $EXECUTABLE \
  Cargo.lock \
  Cargo.toml \
  LICENSE \
  README.md \
  $DIST/ord-$VERSION

cd $DIST
echo "Creating release archive..."
case $OS in
  ubuntu-latest | macos-latest)
    ARCHIVE=$DIST/ord-$VERSION-$TARGET.tar.gz
    tar czf "$ARCHIVE" "ord-$VERSION"
    if [[ -n "${GITHUB_OUTPUT+x}" ]]; then
      echo archive=$ARCHIVE >> $GITHUB_OUTPUT
    fi
    ;;
  windows-*)
    ARCHIVE=$DIST/ord-$VERSION-$TARGET.zip
    7z a "$ARCHIVE" "ord-$VERSION"
    if [[ -n "${GITHUB_OUTPUT+x}" ]]; then
      echo archive=`pwd -W`/ord-$VERSION-$TARGET.zip >> $GITHUB_OUTPUT
    fi
    ;;
esac
