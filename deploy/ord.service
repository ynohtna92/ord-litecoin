[Unit]
After=network-online.target litecoind.service
Wants=network-online.target litecoind.service
Description=Ord server
StartLimitBurst=120
StartLimitIntervalSec=10m

[Service]
EnvironmentFile=/etc/ord/environment
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=RUST_BACKTRACE=1
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/ord \
  --litecoin-data-dir /var/lib/litecoind \
  --cookie-file ${COOKIE_FILE} \
  --chain ${ORD_CHAIN} \
  --config-dir /var/lib/ord \
  --datadir /var/lib/ord \
  --index-addresses \
  --index-runes \
  --index-sats \
  server \
  --acme-domain ${DOMAIN} \
  --csp-origin https://${DOMAIN} \
  --http \
  --https
Group=ord
LimitNOFILE=65536
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
Restart=on-failure
RestartSec=5s
StateDirectory=ord
StateDirectoryMode=0700
TimeoutStopSec=10m
Type=simple
User=ord
WorkingDirectory=/var/lib/ord

[Install]
WantedBy=multi-user.target
