#!/usr/bin/env bash

# This script is idempotent.

set -euo pipefail

CHAIN=$1
DOMAIN=$2
BRANCH=$3
COMMIT=$4
REVISION="ord-$BRANCH-$COMMIT"

export DEBIAN_FRONTEND=noninteractive

touch ~/.hushlogin

hostnamectl set-hostname $DOMAIN

apt-get install --yes \
  acl \
  build-essential \
  clang \
  cmake \
  git \
  python3 \
  wget \
  curl \
  libsqlite3-dev\
  libssl-dev \
  locales-all \
  pkg-config \
  ufw \
  vim

ufw allow 8080
ufw allow http
ufw allow https
ufw allow ssh

case $CHAIN in
  main|mainnet)
    CHAIN=main
    ORD_CHAIN=mainnet
    COOKIE_FILE_DIR=/var/lib/litecoind
    ufw allow 9333
    ;;
  regtest)
    ORD_CHAIN=regtest
    COOKIE_FILE_DIR=/var/lib/litecoind/regtest
    ufw allow 19444
    ;;
  signet)
    ORD_CHAIN=signet
    COOKIE_FILE_DIR=/var/lib/litecoind/signet
    ufw allow 39335
    ;;
  test|testnet)
    CHAIN=test
    ORD_CHAIN=testnet
    COOKIE_FILE_DIR=/var/lib/litecoind/testnet4
    ufw allow 19335
    ;;
  testnet4)
    echo "Use test for Litecoin testnet; a separate testnet4 chain is unsupported." >&2
    exit 1
    ;;
  *)
    echo "Unknown chain: $CHAIN"
    exit 1
    ;;
esac

install -d -m 0755 /etc/ord
install -m 0600 /dev/stdin /etc/ord/environment <<EOF
CORE_CHAIN=$CHAIN
ORD_CHAIN=$ORD_CHAIN
DOMAIN=$DOMAIN
COOKIE_FILE_DIR=$COOKIE_FILE_DIR
COOKIE_FILE=$COOKIE_FILE_DIR/.cookie
EOF

sed -i -E 's/#?PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
sshd -t
systemctl restart sshd

ufw --force enable

if ! which litecoind; then
  ./bin/install-litecoin-core-linux
fi

litecoind --version

rm -f /var/lib/bitcoind/settings.json

if [[ ! -e ~/.cargo/env ]]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

source ~/.cargo/env

rustup update stable

if command -v python > /dev/null; then
  python bin/prepare-vendor
else
  python3 bin/prepare-vendor
fi
cargo build --locked --release
install --backup target/release/ord /usr/local/bin/ord

id --user litecoin || useradd --system --user-group --home-dir /var/lib/litecoind --shell /usr/sbin/nologin litecoin
id --user ord || useradd --system --user-group --home-dir /var/lib/ord --shell /usr/sbin/nologin ord

cp deploy/litecoind.service /etc/systemd/system/

install -d -o root -g litecoin -m 0750 /etc/litecoin
install -o root -g litecoin -m 0640 deploy/litecoin.conf /etc/litecoin/litecoin.conf

if [[ ! -e ~/.litecoin/litecoin.conf ]]; then
  mkdir -p ~/.litecoin
  ln -s /etc/litecoin/litecoin.conf ~/.litecoin/litecoin.conf
fi

systemctl daemon-reload
systemctl enable litecoind
systemctl restart litecoind

while [[ ! -f $COOKIE_FILE_DIR/.cookie ]]; do
  echo "Waiting for litecoind…"
  sleep 1
done

setfacl -m ord:x /var/lib/litecoind
setfacl -m ord:x $COOKIE_FILE_DIR
setfacl -dm ord:r $COOKIE_FILE_DIR
setfacl -m ord:r $COOKIE_FILE_DIR/.cookie

journalctl --unit ord --vacuum-time 1s

cp deploy/ord.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable ord
systemctl restart ord

while ! curl --fail https://$DOMAIN/status > /dev/null; do
  echo "Waiting for ord at https://$DOMAIN/status…"
  sleep 1
done
