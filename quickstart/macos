#!/usr/bin/env bash

set -euxo pipefail

# install Litecoin Core from https://litecoin.org/
if ! command -v litecoind || ! command -v litecoin-cli; then
  echo 'Install Litecoin Core with litecoind and litecoin-cli in PATH.' >&2
  exit 1
fi

# check litecoind
litecoind --version

# write config
mkdir -p ~/Library/Application\ Support/Litecoin
if [[ ! -f ~/Library/Application\ Support/Litecoin/litecoin.conf ]]; then
  printf 'server=1\ntxindex=1\nrpcserialversion=1\n' > ~/Library/Application\ Support/Litecoin/litecoin.conf
fi

# start litecoind
if ! litecoin-cli getblockchaininfo; then
  litecoind -daemon
fi

# check litecoind
litecoin-cli -rpcwait getblockchaininfo

# install ord
if ! command -v ord; then
  curl --proto '=https' --tlsv1.2 -fsLS https://raw.githubusercontent.com/ynohtna92/ord-litecoin/master/install.sh | bash -s
fi

# check ord
ord --version
